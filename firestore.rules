rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} { 
      allow read, write: if false; 
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);
      
      match /profile/{document=**} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
      
      match /flashcards/{document=**} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
      
      match /interviewSessions/{document=**} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      match /socraticSessions/{document=**} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
    }

    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(userId) && isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'score'])
        && request.resource.data.username is string && request.resource.data.username.size() <= 64
        && request.resource.data.score is number;
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
